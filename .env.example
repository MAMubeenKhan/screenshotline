# Copy to .env and edit. Nothing here is required for local development.

PORT=3000
HOST=0.0.0.0

# Concurrency. One render at a time per browser.
POOL_SIZE=2

# Recycle a browser after this many renders. Chrome does not release memory
# cleanly across navigations; this is what stops the OOM killer finding you.
MAX_RENDERS_PER_BROWSER=50
MAX_BROWSER_AGE_MS=1800000

# Wall-clock ceiling on a render. On expiry the browser is SIGKILLed.
RENDER_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=25000

RATE_LIMIT_PER_MINUTE=60

# Comma-separated. Empty means open mode - local development only.
ACCESS_KEYS=

# Required for signed URLs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=

# Reject any request without a valid signature. Turn on for keys that appear
# in browser-visible URLs.
REQUIRE_SIGNATURE=false

CACHE_DIR=.cache
DEFAULT_CACHE_TTL=86400

# NEVER enable in production. Allows rendering localhost and RFC1918 targets.
ALLOW_PRIVATE_HOSTS=false

# --- Billing and accounts ---------------------------------------------------
# Off by default. Self-hosted deployments use ACCESS_KEYS (or open mode) and
# never meter anything. The hosted deployment turns this on.
BILLING_ENABLED=false
DB_FILE=.data/screenshotline.db

# Polar (polar.sh) is the merchant of record - it collects the money and
# handles sales tax/VAT/GST, which is why this is not Stripe direct.
# Use the sandbox until you have tested the whole flow end to end.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_GROWTH=
POLAR_PRODUCT_SCALE=
POLAR_SUCCESS_URL=

# Overage billing. EMPTY MEANS OFF - nothing is ingested and only the fixed
# subscription price is charged. To enable: create a meter in Polar, add a
# metered price to each product, issue a token with the events:write scope,
# then set this to the meter's event name.
POLAR_USAGE_METER=
POLAR_USAGE_FLUSH_MS=10000
